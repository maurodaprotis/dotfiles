// SSH splash. Shown by zsh/motd.sh when fastfetch is installed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1 } },
  "display": { "separator": ": " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    { "type": "disk", "folders": "/" },
    { "type": "localip", "key": "Tailnet", "namePrefix": "tailscale" },
    { "type": "localip", "key": "Local IP", "showIpv4": true, "compact": true },
    "break",
    "colors"
  ]
}
