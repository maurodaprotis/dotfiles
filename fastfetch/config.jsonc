// SSH splash. Shown by zsh/motd.sh when fastfetch is installed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "ubuntu_old", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": ": " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    { "type": "disk", "folders": "/" },
    { "type": "localip", "key": "Tailnet", "namePrefix": "tailscale", "defaultRouteOnly": false, "showPrefixLen": false },
    { "type": "localip", "key": "Local IP", "compact": true },
    "break",
    "colors"
  ]
}
