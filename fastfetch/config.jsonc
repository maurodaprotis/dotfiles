// SSH splash. Shown by zsh/motd.sh when fastfetch is installed.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Ubuntu orange (256-color 208) for the logo and the keys; white for the circle of friends
  "logo": { "type": "builtin", "source": "ubuntu_old", "color": { "1": "38;5;208", "2": "white" }, "padding": { "top": 1, "right": 3 } },
  "display": { "separator": ": ", "color": { "keys": "38;5;208", "title": "38;5;208" } },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    { "type": "disk", "folders": "/" },
    { "type": "localip", "key": "Tailnet", "namePrefix": "tailscale", "defaultRouteOnly": false, "showPrefixLen": false },
    { "type": "localip", "key": "Local IP", "compact": true },
    "break",
    "colors"
  ]
}
