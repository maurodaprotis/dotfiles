# ─── Homebrew ────────────────────────────────────────────────────────
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ─── Oh My Zsh ────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # prompt.zsh handles the prompt

plugins=(git)

bindkey '\e[A' history-search-backward
bindkey '\e[B' history-search-forward

source $ZSH/oh-my-zsh.sh

# ─── Editor ──────────────────────────────────────────────────────────
if command -v cursor >/dev/null; then
  export EDITOR='cursor --wait'
else
  export EDITOR='nvim'
fi

# ─── Aliases ─────────────────────────────────────────────────────────
command -v batcat >/dev/null && alias bat=batcat  # Ubuntu package name
alias c="code ."
alias ls="eza -lahF --git"

# ─── Better man pages ────────────────────────────────────────────────
export MANPAGER="sh -c 'col -bx | $(command -v bat || command -v batcat) -l man -p'"

# ─── Autosuggestions ─────────────────────────────────────────────────
for f in /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [ -f "$f" ] && source "$f" && break
done

# ─── NVM ─────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# ─── pyenv ───────────────────────────────────────────────────────────
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

# ─── pnpm ────────────────────────────────────────────────────────────
export PNPM_HOME="$HOME/Library/pnpm"
if [ -d "$PNPM_HOME" ]; then
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
fi

# ─── console-ninja ───────────────────────────────────────────────────
[ -d ~/.console-ninja/.bin ] && PATH=~/.console-ninja/.bin:$PATH

# ─── bun ─────────────────────────────────────────────────────────────
if [ -d "$HOME/.bun" ]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
fi

# ─── uv ──────────────────────────────────────────────────────────────
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# ─── Local bin (claude, codex, t3, uv) ───────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# Lima VMs append this block to ~/.zshrc unless it is already present
# Lima BEGIN
# Make sure iptables and mount.fuse3 are available
PATH="$PATH:/usr/sbin:/sbin"
export PATH
# Lima END

# ─── Prompt (Warp-style) ─────────────────────────────────────────────
# Resolve dotfiles dir from the symlink: ~/.zshrc → dotfiles/zsh/zshrc
_DOTFILES_ZSHRC="${(%):-%N}"
if [[ -L "$HOME/.zshrc" ]]; then
  _DOTFILES_ZSHRC="$(readlink "$HOME/.zshrc")"
  # Handle relative symlinks
  [[ "$_DOTFILES_ZSHRC" != /* ]] && _DOTFILES_ZSHRC="$HOME/$_DOTFILES_ZSHRC"
fi
_DOTFILES_DIR="$(cd "$(dirname "$_DOTFILES_ZSHRC")/.." && pwd)"
source "$_DOTFILES_DIR/prompt.zsh"

# ─── SSH splash (once per session, not inside tmux) ──────────────────
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" && -z "$_MOTD_SHOWN" && -t 1 ]]; then
  export _MOTD_SHOWN=1
  "$_DOTFILES_DIR/zsh/motd.sh"
fi
unset _DOTFILES_ZSHRC _DOTFILES_DIR
